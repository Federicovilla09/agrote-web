---
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/atkinson-hyperlegible/latin-400";
import "@fontsource/atkinson-hyperlegible/latin-700";
import "@fontsource/ibm-plex-mono/latin-400";
import "@fontsource/ibm-plex-mono/latin-500";
import "../styles/global.css";
import fuenteTitulos from "@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url";
import fuenteTexto from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Maquinaria, tecnología y posventa para el campo. Prototipo conceptual de rediseño.",
} = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta name="robots" content="noindex, nofollow" />
    <meta charset="utf-8" />
    <!-- Favicon: ICO de respaldo, SVG para navegadores modernos e ícono para la pantalla de inicio de iPhone -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={fuenteTitulos}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={fuenteTexto}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E2350" />
    <title>{`${title} · AgroTe`}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
