---
import "@fontsource/big-shoulders-display/latin-800";
import "@fontsource/atkinson-hyperlegible/latin-400";
import "@fontsource/atkinson-hyperlegible/latin-700";
import "@fontsource/ibm-plex-mono/latin-400";
import "@fontsource/ibm-plex-mono/latin-500";
import "../styles/global.css";
import fuenteTitulos from "@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url";
import fuenteTexto from "@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** Imagen para la vista previa al compartir (ruta dentro de public/) */
  image?: string;
}

const {
  title,
  description = "Maquinaria, tecnología y posventa para el campo. Prototipo conceptual de rediseño.",
  image = "/og-image.jpg",
} = Astro.props;

// Las redes necesitan direcciones completas (con https://), no rutas relativas
const urlPagina = new URL(Astro.url.pathname, Astro.site);
const urlImagen = new URL(image, Astro.site);
const tituloCompleto = `${title} · AgroTe`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta name="robots" content="noindex, nofollow" />
    <meta charset="utf-8" />
    <!-- Favicon: ICO de respaldo, SVG para navegadores modernos e ícono para la pantalla de inicio de iPhone -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={fuenteTitulos}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={fuenteTexto}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E2350" />
        <title>{tituloCompleto}</title>
    <link rel="canonical" href={urlPagina} />

    <!-- Vista previa al compartir el link (WhatsApp, LinkedIn, Facebook, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AgroTe" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AgroTe · Desde el tractor hasta el dron" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImagen} />
  </head>
  <body>
    <slot />
  </body>
</html>
