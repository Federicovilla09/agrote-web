---
// EventCard: demostración o charla técnica, con reserva por WhatsApp.
import type { Evento } from "../../data/tipos";
import { whatsappUrl } from "../../lib/whatsapp";
import Button from "../ui/Button.astro";

interface Props {
  evento: Evento;
}
const { evento } = Astro.props;
const mensaje = `Hola, quiero reservar lugar para "${evento.titulo}" del ${evento.dia} de ${evento.mes.toLowerCase()}.`;
---

<article class="card">
  <p class="fecha">
    <span class="text-h2">{evento.dia}</span>
    <span class="text-data-s">{evento.mes}</span>
  </p>
  <div class="info">
    <h3 class="text-h3">{evento.titulo}</h3>
    <p class="text-body-s secundario">{evento.lugar}</p>
    <p class="text-data-s secundario">Evento de demostración</p>
    <Button
      href={whatsappUrl(mensaje)}
      target="_blank"
      variant="secondary"
      size="sm">Reservar lugar</Button
    >
  </div>
</article>

<style>
  .card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    background: var(--color-bg-page);
  }
  .fecha {
    display: grid;
    justify-items: center;
    flex-shrink: 0;
    min-width: 64px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }
  .fecha .text-data-s {
    color: var(--color-text-inverse-secondary);
  }
  .info {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }
  .secundario {
    color: var(--color-text-secondary);
  }
</style>
