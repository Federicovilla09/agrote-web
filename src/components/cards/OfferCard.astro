---
// OfferCard: oferta vigente con etiqueta y consulta por WhatsApp.
import type { Oferta } from "../../data/tipos";
import { optimizar } from "../../lib/imagenes";
import { whatsappUrl } from "../../lib/whatsapp";
import Foto from "../ui/Foto.astro";
import Tag from "../ui/Tag.astro";
import Button from "../ui/Button.astro";

interface Props { oferta: Oferta }
const { oferta } = Astro.props;
const imagen = await optimizar(oferta.imagen);
const mensaje = `Hola, quiero consultar por la oferta de ${oferta.producto}.`;
---

<article class="card">
  <Foto imagen={imagen} alt={oferta.producto} ratio="16 / 9" sizes="(min-width: 1024px) 384px, 270px" />
  <div class="body">
    <Tag tone="offer">Oferta · Demo</Tag>
    <h3 class="text-h3">{oferta.producto}</h3>
    <p class="text-body-s condicion">{oferta.condicion}</p>
    <p class="text-data-s vigencia">{oferta.vigencia}</p>
    <Button href={whatsappUrl(mensaje)} target="_blank" variant="secondary" size="sm" fullWidth class="accion">
      Consultar oferta
    </Button>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-page);
  }
  .body { display: flex; flex-direction: column; flex: 1; align-items: flex-start; gap: var(--space-2); padding: var(--space-4) var(--space-4) var(--space-5); }
  .condicion, .vigencia { color: var(--color-text-secondary); }
  .body :global(.accion) { margin-top: auto; }
</style>