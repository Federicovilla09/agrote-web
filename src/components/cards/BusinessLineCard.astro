---
// BusinessLineCard: acceso a una línea de negocio sobre fondo oscuro.
// Mobile: fila con ícono. Desktop: tarjeta con foto. Mismo HTML, cambia el CSS.
import type { LineaNegocio } from "../../data/tipos";
import { optimizar } from "../../lib/imagenes";
import Foto from "../ui/Foto.astro";
import Icon from "../ui/Icon.astro";

interface Props { linea: LineaNegocio }
const { linea } = Astro.props;
const imagen = await optimizar(linea.imagen, [480, 960]);
---

<a class="card" href={linea.href}>
  <Foto imagen={imagen} alt="" ratio="4 / 5" sizes="227px" class="foto" />
  <span class="icono"><Icon name={linea.icono} /></span>
  <span class="texto">
    <span class="titulo">{linea.titulo}</span>
    <span class="descripcion">{linea.descripcion}</span>
  </span>
  <span class="flecha"><Icon name="chevron-derecha" size={20} /></span>
</a>

<style>
  .card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-bg-inverse-subtle);
    color: var(--color-text-inverse);
    text-decoration: none;
    transition: background-color 150ms;
  }
  @media (hover: hover) {
    .card:hover { background: var(--color-neutral-800); }
  }

  /* Mobile: sin foto, con ícono */
  .card :global(.foto) { display: none; }
  .icono {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    background: var(--color-bg-media);
  }
  .texto { display: grid; gap: var(--space-1); flex: 1; }
  .titulo { font-weight: 700; }
  .descripcion { font-size: var(--text-body-s); line-height: var(--text-body-s-lh); color: var(--color-text-inverse-secondary); }

  /* Desktop: tarjeta vertical con foto */
  @media (min-width: 1024px) {
    .card { flex-direction: column; align-items: stretch; gap: var(--space-3); }
    .card :global(.foto) { display: block; border-radius: var(--radius-sm); }
    .icono { display: none; }
    .titulo { font-family: var(--font-display); font-size: var(--text-heading-h3); line-height: var(--text-heading-h3-lh); font-weight: 800; }
    .flecha { display: none; }
  }
</style>