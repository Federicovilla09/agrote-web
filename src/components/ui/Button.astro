---
// Button (Astro). Si recibe href se dibuja como enlace (<a>), si no, como <button>.
// Los estilos viven en Button.module.css y se comparten con Button.tsx.
import Icon from "./Icon.astro";
import type { IconName } from "./icons";
import styles from "./Button.module.css";

interface Props {
  variant?: "primary" | "secondary" | "accent" | "light" | "link";
  size?: "md" | "sm";
  href?: string;
  icon?: IconName;
  type?: "button" | "submit";
  disabled?: boolean;
  fullWidth?: boolean;
  class?: string;
  target?: "_blank";
}

const {
  variant = "primary",
  size = "md",
  href,
  icon,
  type = "button",
  target,
  disabled = false,
  fullWidth = false,
  class: className,
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class:list={[styles.btn, styles[variant], styles[size], fullWidth && styles.full, className]}
  href={href}
  type={href ? undefined : type}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? "true" : undefined}
  target={target}
>
  <slot />
  {icon && <Icon name={icon} size={18} />}
</Tag>