---
// Tag: etiqueta chica para señalar ofertas, condición o categoría.
interface Props {
  tone?: "offer" | "neutral" | "dark";
}
const { tone = "neutral" } = Astro.props;
---

<span class:list={["tag", `tag--${tone}`]}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-data-s);
    line-height: var(--text-data-s-lh);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .tag--offer { background: var(--color-action-accent); color: var(--color-action-on-accent); }
  .tag--neutral { background: var(--color-bg-muted); color: var(--color-text-primary); }
  .tag--dark { background: var(--color-bg-inverse); color: var(--color-text-inverse); }
</style>