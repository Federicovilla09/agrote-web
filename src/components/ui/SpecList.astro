---
// SpecList: filas de dato y valor (especificaciones técnicas).
// Usa <dl>, la etiqueta de HTML pensada para pares término / descripción.
interface Props {
  items: [string, string][];
}
const { items } = Astro.props;
---

<dl class="specs">
  {items.map(([label, value]) => (
    <div class="fila">
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>

<style>
  .fila {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border-default);
  }
  dt { color: var(--color-text-secondary); font-size: var(--text-body-s); }
  dd { font-family: var(--font-mono); font-size: var(--text-data-l); font-weight: 500; text-align: right; }
</style>