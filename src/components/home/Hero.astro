---
// Hero del inicio: video de fondo desde el primer momento, con su primer cuadro como portada.
import { optimizar, optimizarUnica } from "../../lib/imagenes";
import { whatsappUrl } from "../../lib/whatsapp";
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Foto from "../ui/Foto.astro";
import Tag from "../ui/Tag.astro";

// Portada: el primer cuadro del video (si existe src/assets/images/hero-poster.jpg).
// Una sola versión de 960 px: el poster no acepta srcset y solo se ve hasta que arranca el video.
const poster = await optimizarUnica("hero-poster", 960);
const dron = await optimizar("dron-vuelo", [480]);
---

<!-- El poster es lo primero que se ve: le pedimos al navegador que lo baje con prioridad -->
{poster && <link rel="preload" as="image" href={poster} fetchpriority="high" />}

<section class="hero" data-hero aria-labelledby="hero-titulo">
  <!-- El poster es el primer cuadro del video: no hay salto visual cuando arranca.
       preload="metadata" baja solo lo mínimo; el script lo reproduce enseguida
       salvo con "reducir movimiento" o ahorro de datos. -->
  <video
    class="fondo"
    data-video
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
    aria-hidden="true"
  >
    <source src="/video/hero-desktop.mp4" type="video/mp4" media="(min-width: 768px)" />
    <source src="/video/hero-mobile.mp4" type="video/mp4" />
  </video>
  <div class="degradado" aria-hidden="true"></div>

  <div class="container contenido">
    <div class="principal">
      <Eyebrow tone="dark">Concesionaria agrícola · Litoral</Eyebrow>
      <h1 id="hero-titulo" class="text-display-xl titulo">
        <span class="linea">Desde el tractor</span>
        <span class="linea">hasta el dron</span>
      </h1>
      <p class="text-body-l bajada">
        Equipamos tu campo y te acompañamos después: maquinaria nueva y usada, tecnología de precisión y posventa.
      </p>
      <div class="acciones">
        <Button href="/nuevos/tractores" variant="accent" icon="flecha-derecha">Explorar catálogo</Button>
        <Button href={whatsappUrl("Hola, quiero hacer una consulta.")} target="_blank" variant="light" icon="chat">
          Consultar por WhatsApp
        </Button>
      </div>
    </div>

    <!-- Tarjeta destacada: solo desktop -->
    <a class="destacada" href="/precision-y-drones">
      <Foto imagen={dron} alt="" ratio="16 / 9" sizes="268px" class="destacada-foto" />
      <Tag tone="offer">Nuevo</Tag>
      <span class="destacada-titulo">Drones de pulverización y mapeo</span>
      <span class="destacada-link">Conocer más <Icon name="flecha-derecha" size={18} /></span>
    </a>
  </div>

  <div class="container controles">
    <button type="button" class="descubrir text-data-s" data-descubrir>
      Deslizá para descubrir
      <span class="flecha"><Icon name="chevron-abajo" size={18} /></span>
    </button>
    <button type="button" class="pausa" data-pausa aria-pressed="false" aria-label="Pausar video">
      <Icon name="pausa" size={18} class="icono-pausa" />
      <Icon name="reproducir" size={18} class="icono-reproducir" />
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh; /* la portada ocupa toda la pantalla */
    padding-top: 96px; /* espacio para el header que flota encima */
    overflow: hidden;
    background: var(--color-bg-media);
    color: var(--color-text-inverse);
  }

  .fondo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Oscurece arriba (para el header) y abajo (para el texto) */
  .degradado {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(12 16 24 / 0.6), transparent 30%),
      linear-gradient(to top, rgb(12 16 24 / 0.92) 10%, rgb(14 35 80 / 0) 70%);
  }

  .contenido, .controles { position: relative; }

  /* Transición de apertura: el contenido sube y se desvanece, la imagen se acerca */
  .fondo, .contenido, .controles { transition: transform 900ms cubic-bezier(0.65, 0, 0.35, 1), opacity 600ms ease; }
  .hero.abriendo .fondo { transform: scale(1.08); }
  .hero.abriendo .contenido,
  .hero.abriendo .controles { transform: translateY(-40px); opacity: 0; }
  .contenido { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-8); }
  .principal { display: grid; gap: var(--space-4); max-width: 44rem; }
  .bajada { color: var(--color-text-inverse-secondary); max-width: 36rem; }

  /* Título en dos frases fijas: "Desde el tractor" / "hasta el dron".
     Cada frase ocupa una línea y el tamaño se ajusta para que "Desde el tractor"
     (unos 5,8 em) siempre entre en el ancho disponible, sin pasar de Display XL. */
  .titulo .linea { display: block; white-space: nowrap; }
  .titulo { font-size: min(var(--text-display-xl), calc((100vw - 2 * var(--layout-margin-mobile)) / 5.9)); }

  .acciones { display: grid; gap: var(--space-3); padding-top: var(--space-2); }

  .destacada { display: none; }

  .controles {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
    color: var(--color-text-inverse-secondary);
  }
  .descubrir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    color: var(--color-text-inverse-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .descubrir:hover { color: var(--color-text-inverse); }
  /* La flecha "respira" para invitar a bajar (se detiene con reducir movimiento) */
  .flecha { display: grid; animation: invitar 1.8s ease-in-out infinite; }
  @keyframes invitar { 50% { transform: translateY(4px); } }

  .pausa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
    color: var(--color-text-inverse);
  }
  /* El botón muestra "pausa" mientras corre y "reproducir" cuando está pausado */
  .pausa :global(.icono-reproducir) { display: none; }
  .pausa[aria-pressed="true"] :global(.icono-pausa) { display: none; }
  .pausa[aria-pressed="true"] :global(.icono-reproducir) { display: block; }

  @media (min-width: 768px) {
    .acciones { display: flex; flex-wrap: wrap; }
    .titulo { font-size: min(var(--text-display-xl), calc((100vw - 2 * var(--layout-margin-tablet)) / 5.9)); }
  }

  @media (min-width: 1024px) {
    /* Columna de texto = contenedor − tarjeta destacada (300 px) − separación (32 px) */
    .titulo { font-size: min(var(--text-display-xl), calc((min(1200px, 100vw - 240px) - 332px) / 5.9)); }
    .degradado {
      background:
        linear-gradient(to bottom, rgb(12 16 24 / 0.5), transparent 25%),
        linear-gradient(to right, rgb(12 16 24 / 0.9), rgb(14 35 80 / 0.15) 65%);
    }
    .controles { padding-block: var(--space-12); }
    .destacada {
      display: grid;
      gap: var(--space-3);
      width: 300px;
      flex-shrink: 0;
      padding: var(--space-4);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-lg);
      background: var(--color-bg-inverse-subtle);
      text-decoration: none;
      justify-items: start;
    }
    .destacada :global(.destacada-foto) { border-radius: var(--radius-sm); }
    .destacada-titulo { font-family: var(--font-display); font-size: var(--text-heading-h3); line-height: var(--text-heading-h3-lh); font-weight: 800; }
    .destacada-link { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 700; }
    .destacada:hover .destacada-link { text-decoration: underline; }
  }
</style>

<script>
  import { iniciarPortada } from "../../lib/portada";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) iniciarPortada(hero);
</script>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-video]");
  const pausa = document.querySelector<HTMLButtonElement>("[data-pausa]");

  if (video && pausa) {
    // Con "reducir movimiento" o ahorro de datos, el video arranca pausado (se ve el primer cuadro)
    const reducirMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ahorroDatos = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

    const mostrarEstado = (pausado: boolean) => {
      pausa.setAttribute("aria-pressed", String(pausado));
      pausa.setAttribute("aria-label", pausado ? "Reproducir video" : "Pausar video");
    };

    if (reducirMovimiento || ahorroDatos) {
      mostrarEstado(true);
    } else {
      // play() devuelve una promesa: si el navegador bloquea la reproducción, queda pausado
      video.play().then(() => mostrarEstado(false)).catch(() => mostrarEstado(true));
    }

    pausa.addEventListener("click", () => {
      if (video.paused) {
        video.play();
        mostrarEstado(false);
      } else {
        video.pause();
        mostrarEstado(true);
      }
    });
  }
</script>