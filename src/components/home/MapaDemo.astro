---
// Mapa ilustrativo de una ubicación ficticia (no es un mapa real).
// Dibujado en SVG con los colores del sistema: liviano, sin servicios externos
// y claramente de demostración.
---

<figure class="mapa">
  <svg viewBox="0 0 640 360" role="img" aria-labelledby="mapa-titulo" preserveAspectRatio="xMidYMid slice">
    <title id="mapa-titulo">Mapa ilustrativo de la casa central, en una ubicación de demostración junto al río y la ruta</title>

    <!-- Terreno y campos -->
    <rect class="terreno" width="640" height="360" />
    <rect class="campo" x="470" y="-20" width="190" height="110" rx="10" />
    <rect class="campo" x="500" y="250" width="160" height="130" rx="10" />
    <rect class="campo" x="150" y="270" width="120" height="110" rx="10" />

    <!-- Río -->
    <path class="rio" d="M70 -20 C 140 80, 20 160, 90 240 S 120 340, 60 380" />

    <!-- Manzanas de la ciudad -->
    <g class="manzanas">
      <rect x="230" y="70" width="70" height="50" rx="6" /><rect x="312" y="70" width="70" height="50" rx="6" />
      <rect x="230" y="132" width="70" height="50" rx="6" /><rect x="312" y="200" width="70" height="50" rx="6" />
      <rect x="394" y="132" width="70" height="50" rx="6" /><rect x="394" y="200" width="70" height="50" rx="6" />
      <rect x="230" y="200" width="70" height="50" rx="6" />
    </g>

    <!-- Ruta (borde + calzada) -->
    <path class="ruta-borde" d="M-20 300 C 160 260, 260 190, 420 190 S 600 120, 660 110" />
    <path class="ruta" d="M-20 300 C 160 260, 260 190, 420 190 S 600 120, 660 110" />
    <text class="etiqueta-ruta" x="482" y="208" transform="rotate(-9 482 208)">Ruta de demostración</text>

    <!-- Marcador de la casa central -->
    <g class="marcador" transform="translate(348 150)">
      <path class="pin" d="M0 -46 C -16 -46, -28 -34, -28 -18 C -28 2, 0 22, 0 22 C 0 22, 28 2, 28 -18 C 28 -34, 16 -46, 0 -46 Z" />
      <circle class="pin-centro" cx="0" cy="-18" r="11" />
      <circle class="pin-punto" cx="0" cy="-18" r="5" />
    </g>

    <!-- Etiqueta del lugar -->
    <g transform="translate(388 96)">
      <rect class="cartel" width="176" height="38" rx="8" />
      <text class="cartel-texto" x="14" y="24">AgroTe · Casa central</text>
    </g>
  </svg>
  <figcaption class="text-data-s">Mapa ilustrativo · Ubicación de demostración</figcaption>
</figure>

<style>
  .mapa { display: grid; gap: var(--space-2); width: 100%; margin: 0; }
  svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
  }
  figcaption { color: var(--color-text-secondary); }

  .terreno { fill: var(--color-neutral-50); }
  .campo { fill: var(--color-green-100); }
  .rio { fill: none; stroke: var(--color-blue-200); stroke-width: 44; stroke-linecap: round; }
  .manzanas rect { fill: var(--color-neutral-0); stroke: var(--color-border-default); }
  .ruta-borde { fill: none; stroke: var(--color-neutral-300); stroke-width: 20; stroke-linecap: round; }
  .ruta { fill: none; stroke: var(--color-neutral-0); stroke-width: 14; stroke-linecap: round; }
  .etiqueta-ruta { font-family: var(--font-mono); font-size: 12px; fill: var(--color-neutral-500); }

  .pin { fill: var(--color-action-primary); }
  .pin-centro { fill: var(--color-neutral-0); }
  .pin-punto { fill: var(--color-action-accent); }
  .cartel { fill: var(--color-neutral-0); stroke: var(--color-border-default); }
  .cartel-texto { font-family: var(--font-body); font-size: 14px; font-weight: 700; fill: var(--color-text-primary); }
</style>