---
// Navegación interna: anclas a cada sección de la página.
// Queda fija debajo del header y marca la sección que se está viendo.
import { seccionesPrecision } from "../../data/precision";
---

<nav class="nav" aria-label="Secciones de la página" data-nav-interna>
  <div class="container fila">
    <ul class="lista" data-lista>
      {seccionesPrecision.map((s) => (
        <li><a href={`#${s.id}`} class="chip" data-ancla={s.id}>{s.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 64px; /* justo debajo del header */
    z-index: 40;
    border-bottom: 1px solid var(--color-border-default);
    background: var(--color-bg-page);
    transition: top 250ms ease;
  }
  /* En mobile el header se esconde al bajar: la navegación sube a ocupar su lugar */
  :global(body:has([data-header].oculto)) .nav { top: 0; }

  /* En mobile los chips se deslizan en horizontal */
  .lista {
    display: flex;
    flex: 1;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-3) 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }
  .lista::-webkit-scrollbar { display: none; }

  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-data-s);
    white-space: nowrap;
    text-decoration: none;
    transition: background-color 150ms, color 150ms, border-color 150ms;
  }
  .chip:hover { border-color: var(--color-text-primary); }
  /* Sección visible: chip activo */
  .chip[aria-current="true"] {
    border-color: var(--color-action-primary);
    background: var(--color-action-primary);
    color: var(--color-action-on-primary);
  }

  .fila :global(.consultar) { display: none; }

  @media (min-width: 1024px) {
    .nav { top: 80px; }
  }
</style>

<script>
  const lista = document.querySelector<HTMLElement>("[data-lista]");
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>("[data-ancla]")];

  // Marca el chip de una sección y lo centra en la fila (en mobile, donde se desliza)
  function marcar(id: string) {
    enlaces.forEach((enlace) => {
      const activo = enlace.dataset.ancla === id;
      if (activo) {
        enlace.setAttribute("aria-current", "true");
        if (lista) {
          const centro = enlace.offsetLeft - (lista.clientWidth - enlace.offsetWidth) / 2;
          lista.scrollTo({ left: centro, behavior: "smooth" });
        }
      } else {
        enlace.removeAttribute("aria-current");
      }
    });
  }

  // Scroll spy: la sección que cruza la franja del medio de la pantalla es la "actual"
  const observer = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((entrada) => {
        if (entrada.isIntersecting) marcar(entrada.target.id);
      });
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );

  enlaces.forEach((enlace) => {
    const seccion = document.getElementById(enlace.dataset.ancla ?? "");
    if (seccion) observer.observe(seccion);
  });
</script>